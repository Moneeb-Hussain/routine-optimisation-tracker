# Environment template — copy to .env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — needed for cron email reminders (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI chat / briefs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional semantic document search for coach (defaults to text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional email reminders (Resend) + cron auth
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mission USA AI <onboarding@yourdomain.com>
CRON_SECRET=
